{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "declaration": true, "emitDeclarationOnly": true, "outDir": "dist/types", "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
